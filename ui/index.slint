import "config/fonts/Outfit-Variable.ttf";
import { Header } from "layout/Header.slint";
import { Sidebar } from "layout/Sidebar.slint";
import { Content } from "layout/Content.slint";
import { LoginPrompt } from "components/LoginPrompt.slint";
import { ExplorerItem } from "models.slint";


export component RootWindow inherits Window {
    default-font-family: "Outfit";
    default-font-size: 16px;
    default-font-weight: 600;
    
    // Component styles
    title: "Sebox Locker"; 
    min-width: 800px;
    min-height: 500px;
    background: #EEF5EF;
    
    // Authentication
    in-out property <bool> is_authenticated: false;
    callback login_submitted(string);

    // File Picker
    callback open_nfd_files_selector();
    callback open_nfd_folder_selector();
 
    // File Explorer
    in property <[ExplorerItem]> explorer_items;
    callback open_file(string);

    VerticalLayout {
        Header {
            height: 80px;
        }

        if (!is_authenticated) : HorizontalLayout {
            alignment: center;
            
            LoginPrompt {
                login_submitted(user_input) => { root.login_submitted(user_input); }
            }
        }

        if(is_authenticated) : HorizontalLayout {
            Sidebar {
                width: 300px;
                vertical-stretch: 1; 
                add_files => { root.open_nfd_files_selector(); }
                add_folder => { root.open_nfd_folder_selector(); }
            }

            Content {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                explorer_items: root.explorer_items;
                open_file(filepath) => {root.open_file(filepath); }
            }
        }
    }
}